{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "paths": {
      "@woodstock/engine": [
        "./packages/engine/src/index.ts"
      ],
      "@woodstock/engine/*": [
        "./packages/engine/src/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "expo-env.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "packages/engine/test",
    "staging",
    "web-build"
  ]
}