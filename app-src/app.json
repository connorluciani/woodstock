{
  "expo": {
    "name": "Woodstock",
    "slug": "woodstock",
    "version": "0.1.0",
    "scheme": "woodstock",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F2F7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ca.woodstock.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Woodstock uses Face ID to confirm the payday requests and orders you approve."
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Woodstock",
      "shortName": "Woodstock",
      "themeColor": "#F2F2F7",
      "backgroundColor": "#F2F2F7",
      "description": "Goals first. Pay yourself first, every payday."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#F2F2F7", "image": "./assets/splash-icon.png", "imageWidth": 120, "dark": { "backgroundColor": "#000000" } }],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/woodstock"
    }
  }
}
